{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ServiceRequestExtraction",
  "type": "object",
  "additionalProperties": false,
  "required": ["intent", "serviceType", "assetType", "brand", "model", "problem", "urgency", "preferredDate", "preferredStartTime", "preferredEndTime", "customerReference", "confidence", "unknownFields"],
  "properties": {
    "intent": {"type":"string","enum":["service_request","status_query","cancellation","unknown"]},
    "serviceType": {"type":["string","null"]},
    "assetType": {"type":["string","null"]},
    "brand": {"type":["string","null"]},
    "model": {"type":["string","null"]},
    "problem": {"type":["string","null"]},
    "urgency": {"type":["string","null"],"enum":["low","medium","high","safety_critical",null]},
    "preferredDate": {"type":["string","null"]},
    "preferredStartTime": {"type":["string","null"]},
    "preferredEndTime": {"type":["string","null"]},
    "customerReference": {"type":["string","null"]},
    "confidence": {"type":"number","minimum":0,"maximum":1},
    "unknownFields": {"type":"array","items":{"type":"string"}}
  }
}
