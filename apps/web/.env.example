# Server-only configuration for the KaamSetu web app. Copy to .env.local (gitignored).
# Nothing here is prefixed NEXT_PUBLIC_, so none of it is ever sent to the browser: the app calls
# the API from the server (Server Components and Server Actions) and adds the demo key there.

# Base URL of the KaamSetu API, including the /api/v1 prefix. No trailing slash.
#   local stack:  http://127.0.0.1:8101/api/v1
#   deployed:     <ApiUrl output of the SAM stack>/api/v1
KAAMSETU_API_URL=

# The API's demo key, sent as X-Demo-Key. Required when the API runs with APP_ENV=demo.
# Real values must never be committed or shown in a screenshot.
KAAMSETU_DEMO_KEY=

# IANA timezone used to show times and to read "today" for the business.
KAAMSETU_TIMEZONE=Asia/Kolkata
