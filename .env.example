# Runtime
APP_ENV=development
APP_NAME=kaamsetu

# AI provider: bedrock | ollama
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b

# AWS (used only for cloud mode)
AWS_REGION=ap-south-1
AWS_PROFILE=

# Storage/data adapters
DATA_PROVIDER=local
OBJECT_STORAGE_PROVIDER=local
SEARCH_PROVIDER=local

# Never put real secrets in this file.
