# Runtime
# APP_ENV: development | test | demo | production. Unset means production (fail closed): no caller
# is accepted and DATA_PROVIDER=memory is not allowed.
#   development/test  fixed identity below, no credentials
#   demo              fixed identity below, only for callers sending the DEMO_API_KEY secret
APP_ENV=development
APP_NAME=kaamsetu
LOG_LEVEL=INFO

# AI provider: bedrock | ollama | disabled. Only bedrock is implemented; with anything else,
# intake falls back to manual entry. LLM_MODEL is required for bedrock (a Bedrock model or
# inference-profile id).
LLM_PROVIDER=disabled
LLM_MODEL=
AI_TIMEOUT_SECONDS=12
AI_MAX_RETRIES=1
# Timezone used to read relative dates when a business has no record of its own.
DEFAULT_TIMEZONE=UTC

# AWS (used only for cloud mode)
AWS_REGION=us-east-1
AWS_PROFILE=

# Storage/data adapters
# DATA_PROVIDER: memory | dynamodb
DATA_PROVIDER=memory
# Used when DATA_PROVIDER=dynamodb. Leave the endpoint empty for real AWS;
# set it (e.g. http://localhost:4566) for LocalStack or DynamoDB Local.
DYNAMODB_TABLE=kaamsetu
DYNAMODB_ENDPOINT_URL=
OBJECT_STORAGE_PROVIDER=local
SEARCH_PROVIDER=local

# Development-only fixed identity, used when APP_ENV is development or test. Tenant identity is
# always decided server-side and is never taken from a request header or body.
DEV_BUSINESS_ID=bus_demo
DEV_ACTOR_ID=usr_dev

# Only for APP_ENV=demo (at least 32 characters). Sent by callers in the X-Demo-Key header. Set it
# in the deployment environment, never in this file: real values must not be committed.
DEMO_API_KEY=

# Never put real secrets in this file.
